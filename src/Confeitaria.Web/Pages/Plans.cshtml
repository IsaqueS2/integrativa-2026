@page "/Plans"
@{
    ViewData["Title"] = "Planos";
    var plans = new[]
    {
        new { Id = "basico", Name = "Básico", Focus = "Precificação", Price = "24,90", Users = "1 usuário", Recommended = false,
            Description = "Para transformar suas receitas em preços que fazem sentido.",
            Features = new[] { "Fichas técnicas e ingredientes ilimitados", "Precificação automática", "Custos de insumos, embalagem, gás e mão de obra", "Relatórios financeiros simples" },
            Limit = "Não inclui agenda, estoque ou cardápio digital." },
        new { Id = "essencial", Name = "Essencial", Focus = "Encomendas", Price = "39,90", Users = "2 usuários", Recommended = true,
            Description = "Para organizar os pedidos e acompanhar cada cliente de perto.",
            Features = new[] { "Tudo do plano Básico", "Agenda completa de encomendas", "Orçamentos por WhatsApp ou link", "Gestão de clientes", "Precificação pelo custo da matéria-prima" },
            Limit = "Não inclui estoque ou cardápio digital." },
        new { Id = "pro", Name = "Pro", Focus = "Gestão e estoque", Price = "59,90", Users = "5 usuários", Recommended = false,
            Description = "Para conectar as vendas, os insumos e a rotina da sua equipe.",
            Features = new[] { "Tudo do plano Essencial", "Cardápio digital com pedidos por WhatsApp", "Controle de estoque inteligente", "Alertas de reajuste dos insumos", "Multiusuário com permissões" },
            Limit = "A proposta mais completa para o seu negócio." }
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/plans.css" asp-append-version="true" />
}
<div class="plans-page">
    <div class="page-heading plans-heading">
        <div class="page-heading-copy">
            <p class="eyebrow">Um próximo passo para o seu negócio</p>
            <h1>Nossos planos</h1>
            <p>Mais tempo para criar. Mais clareza para crescer.</p>
        </div>
        <div class="plans-period"><span aria-hidden="true"></span>Planos mensais</div>
    </div>

    <div class="plans-intro">
        <p>Escolha o cuidado que sua confeitaria precisa hoje.</p>
        <a href="#plan-comparison">Comparar os recursos <span aria-hidden="true">↓</span></a>
    </div>

    <div class="plans-grid" aria-label="Planos disponíveis">
        @foreach (var plan in plans)
        {
            <article class="plan-card @(plan.Recommended ? "plan-card-recommended" : "")" aria-labelledby="plan-@plan.Id-title" data-plan="@plan.Id">
                <div class="plan-card-top">
                    <span class="plan-icon" aria-hidden="true">
                        @if (plan.Id == "basico")
                        {
                            <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h1m3 0h1m3 0h.01M8 15h1m3 0h1m3 0h.01M8 18h1m3 0h1m3 0h.01"/></svg>
                        }
                        else if (plan.Id == "essencial")
                        {
                            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18m-13 4 3 3 5-5"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="M3 10V7l2-4h14l2 4v3M4 12v9h16v-9M3 8h18M3 8v2a3 3 0 0 0 6 0V8m0 0v2a3 3 0 0 0 6 0V8m0 0v2a3 3 0 0 0 6 0V8M9 21v-6h6v6"/></svg>
                        }
                    </span>
                    @if (plan.Recommended)
                    {
                        <span class="plan-badge">Recomendado</span>
                    }
                </div>
                <div class="plan-identity">
                    <p class="plan-focus">@plan.Focus</p>
                    <h2 id="plan-@plan.Id-title">@plan.Name</h2>
                    <p class="plan-description">@plan.Description</p>
                </div>
                <p class="plan-price"><span class="plan-currency">R$</span> <strong>@plan.Price</strong><span class="plan-cadence">/mês</span></p>
                <p class="plan-users"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2m2-16a3 3 0 0 1 0 6m2 10v-2a6 6 0 0 0-2-4"/></svg>@plan.Users</p>
                <ul class="plan-features" aria-label="Recursos do plano @plan.Name">
                    @foreach (var feature in plan.Features)
                    {
                        <li><span class="plan-check" aria-hidden="true">✓</span><span>@feature</span></li>
                    }
                </ul>
                <div class="plan-card-bottom">
                    <p class="plan-limit">@plan.Limit</p>
                    <button class="plan-select @(plan.Recommended ? "" : "secondary")" type="button" data-select-plan="@plan.Id" aria-haspopup="dialog">Escolher @plan.Name <span aria-hidden="true">→</span></button>
                </div>
            </article>
        }
    </div>

    <p class="plans-demo-note"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 5v2"/></svg>Você está conhecendo uma proposta de planos. A seleção é demonstrativa e não gera cobrança.</p>

    <details class="plans-comparison" id="plan-comparison">
        <summary><span><span class="eyebrow">Cada detalhe conta</span><span class="plans-comparison-title">Compare e escolha com calma</span></span><span class="plans-disclosure-icon" aria-hidden="true">+</span></summary>
        <div class="plans-table-wrap" tabindex="0" role="region" aria-label="Comparação dos recursos dos planos">
            <table>
                <caption class="visually-hidden">Recursos previstos em cada plano mensal</caption>
                <thead><tr><th scope="col">Recursos</th><th scope="col">Básico</th><th scope="col">Essencial</th><th scope="col">Pro</th></tr></thead>
                <tbody>
                    <tr><th scope="row">Fichas técnicas e precificação</th><td>Incluído</td><td>Incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Relatórios financeiros simples</th><td>Incluído</td><td>Incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Agenda de encomendas</th><td>Não incluído</td><td>Incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Orçamentos e gestão de clientes</th><td>Não incluído</td><td>Incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Cardápio digital e pedidos por WhatsApp</th><td>Não incluído</td><td>Não incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Estoque e alertas de reajuste</th><td>Não incluído</td><td>Não incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Permissões por usuário</th><td>Não incluído</td><td>Não incluído</td><td>Incluído</td></tr>
                    <tr><th scope="row">Usuários</th><td>1</td><td>2</td><td>5</td></tr>
                    <tr><th scope="row">Valor mensal</th><td>R$ 24,90</td><td>R$ 39,90</td><td>R$ 59,90</td></tr>
                </tbody>
            </table>
        </div>
    </details>

    <div class="plans-questions" aria-labelledby="plans-questions-title">
        <div><p class="eyebrow">Antes de escolher</p><h2 id="plans-questions-title">Tudo às claras.</h2><p>Algumas respostas para conhecer os planos.</p></div>
        <div class="plans-answers">
            <details><summary>Preciso cadastrar um cartão?</summary><p>Não. Esta tela apresenta uma proposta de planos para avaliação. Você pode simular sua escolha sem informar dados de pagamento.</p></details>
            <details><summary>A escolha muda o que posso usar agora?</summary><p>Não. A seleção não ativa uma assinatura nem limita o protótipo atual. Os recursos apresentados são a proposta de cada plano, incluindo funcionalidades previstas para as próximas etapas.</p></details>
            <details><summary>Os valores são mensais?</summary><p>Sim. Os valores apresentados são por mês: R$ 24,90 no Básico, R$ 39,90 no Essencial e R$ 59,90 no Pro. Nenhum pagamento é realizado nesta demonstração.</p></details>
        </div>
    </div>

    <dialog class="plan-dialog" id="plan-selection" aria-labelledby="plan-selection-title" aria-describedby="plan-selection-note">
        <form method="dialog">
            <button class="secondary plan-dialog-close" value="close" aria-label="Fechar seleção" autofocus>×</button>
            <span class="plan-dialog-symbol" aria-hidden="true">✓</span>
            <p class="eyebrow">Sua escolha, em demonstração</p>
            <h2 id="plan-selection-title">Plano <span id="selected-plan-name"></span></h2>
            <p class="plan-dialog-price" id="selected-plan-price"></p>
            <p id="selected-plan-description"></p>
            <p class="plan-dialog-note" id="plan-selection-note">Nenhuma assinatura foi ativada e nenhuma cobrança será realizada. Os recursos e valores fazem parte da proposta de planos.</p>
            <button class="plan-dialog-return" value="close">Voltar aos planos</button>
        </form>
    </dialog>
</div>
@section Scripts {
    <script src="~/js/plans.js" asp-append-version="true"></script>
}
