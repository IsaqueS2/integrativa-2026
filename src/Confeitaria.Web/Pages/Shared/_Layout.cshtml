<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Confeitaria</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header>
    <a class="brand" href="/" aria-label="Confeitaria — página inicial">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 16h16l-2 11H10L8 16Z" fill="currentColor" opacity=".16" />
                <path d="M8 16h16l-2 11H10L8 16Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M10 16c0-2 1.6-3.5 3.5-3.5.4-2.1 2.1-3.5 4-3.5 2.3 0 4 1.8 4 4 1.6.1 2.5 1.2 2.5 3H10Z" fill="currentColor" opacity=".2" />
                <path d="M10 16c0-2 1.6-3.5 3.5-3.5.4-2.1 2.1-3.5 4-3.5 2.3 0 4 1.8 4 4 1.6.1 2.5 1.2 2.5 3H10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M13 20v3m6-3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
        </span>
        <span class="brand-copy"><strong>Confeitaria</strong><span>Gestão simples para quem faz doces</span></span>
    </a>
    <nav aria-label="Navegação principal">
        <a href="/" data-nav-label="Painel"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 10 8.5-7 8.5 7v10a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1V10Z"/><path d="M9 21v-7h6v7"/></svg><span>Painel</span></a>
        <a href="/Movements" data-nav-label="Lançamentos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h8l4 4V20a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2V5.5a2 2 0 0 1 2-2Z"/><path d="M14.5 3.5v5h5M8.5 13h7M8.5 17h7"/></svg><span>Lançamentos</span></a>
        <a href="/Recipes" data-nav-label="Receitas e preços"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13h16l-2 8H6l-2-8Z"/><path d="M6 13c0-2 1.5-3.5 3.5-3.5.5-2.2 2.2-3.5 4-3.5 2.2 0 4 1.7 4 4 1.6.1 2.5 1.2 2.5 3H6Z"/><path d="M10 17v1m4-1v1"/></svg><span>Receitas e preços</span></a>
        <a href="/Settings" data-nav-label="Configurações"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/><path d="m19.4 15 .1.1 1.1.9-1.6 2.8-1.4-.5a7.7 7.7 0 0 1-1.5.9l-.2 1.5h-3.3l-.2-1.5a7.7 7.7 0 0 1-1.5-.9l-1.4.5-1.6-2.8 1.1-.9a7 7 0 0 1 0-1.8l-1.1-.9 1.6-2.8 1.4.5a7.7 7.7 0 0 1 1.5-.9l.2-1.5h3.3l.2 1.5a7.7 7.7 0 0 1 1.5.9l1.4-.5 1.6 2.8-1.1.9a7 7 0 0 1-.1 1.8Z"/></svg><span>Configurações</span></a>
    </nav>
</header>
<main id="conteudo">
    <div id="message" role="status" aria-live="polite" hidden></div>
    @RenderBody()
</main>
<footer><span>Confeitaria · Gestão financeira e custos para o seu negócio artesanal.</span><a class="footer-link" href="/docs" target="_blank" rel="noopener">Documentação da API</a></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
