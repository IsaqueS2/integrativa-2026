<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Confeitaria</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header>
    <a class="brand" href="/" aria-label="Confeitaria — página inicial">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 16h16l-2 11H10L8 16Z" fill="currentColor" opacity=".16" />
                <path d="M8 16h16l-2 11H10L8 16Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M10 16c0-2 1.6-3.5 3.5-3.5.4-2.1 2.1-3.5 4-3.5 2.3 0 4 1.8 4 4 1.6.1 2.5 1.2 2.5 3H10Z" fill="currentColor" opacity=".2" />
                <path d="M10 16c0-2 1.6-3.5 3.5-3.5.4-2.1 2.1-3.5 4-3.5 2.3 0 4 1.8 4 4 1.6.1 2.5 1.2 2.5 3H10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <path d="M13 20v3m6-3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
        </span>
        <span class="brand-copy"><strong>Confeitaria</strong><span>Gestão simples para quem faz doces</span></span>
    </a>
    <nav aria-label="Navegação principal">
        <a href="/" data-nav-label="Painel">Painel</a>
        <a href="/Movements" data-nav-label="Lançamentos">Lançamentos</a>
        <a href="/Recipes" data-nav-label="Receitas e preços">Receitas e preços</a>
        <a href="/Settings" data-nav-label="Configurações">Configurações</a>
    </nav>
</header>
<main id="conteudo">
    <div id="message" role="status" aria-live="polite" hidden></div>
    @RenderBody()
</main>
<footer><span>Confeitaria · Gestão financeira e custos para o seu negócio artesanal.</span><a class="footer-link" href="/docs" target="_blank" rel="noopener">Documentação da API</a></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
