@page
@{ ViewData["Title"] = "Lançamentos"; }
<div class="page-heading page-heading-movements">
    <div class="page-heading-copy">
        <p class="eyebrow">Rotina financeira</p>
        <h1>Lançamentos</h1>
        <p>Registre as vendas do dia e acompanhe o que entra e sai do caixa.</p>
    </div>
    <a class="button" href="#sale-section">+ Registrar venda</a>
</div>
<nav class="section-index movement-index" aria-label="Atalhos de lançamentos">
    <a href="#sale-section">Registrar venda</a>
    <a href="#expense-section">Registrar despesa</a>
    <a href="#owner-section">Aporte ou retirada</a>
    <a href="#movement-history">Histórico</a>
</nav>
<section id="sale-section" class="entry-section entry-sale">
    <h2>Registrar uma venda</h2>
    <p class="hint">Comece com data, valor, canal e forma de pagamento. Os detalhes de custo são opcionais.</p>
    <form id="sale-form">
        <div class="grid sale-core-fields">
            <label>Data da venda<input type="text" name="date" data-today data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" required /></label>
            <label>Valor bruto<input type="text" inputmode="decimal" class="decimal-input" name="gross" placeholder="Ex.: 75,00" required /></label>
            <label>Desconto<input type="text" inputmode="decimal" class="decimal-input" name="discount" value="0,00" required /></label>
            <label>Canal<select name="channelId" data-catalog="channels" required></select></label>
            <label>Meio de pagamento<select name="paymentMethodId" data-catalog="paymentMethods" required></select></label>
            <label>Previsão de recebimento<input type="text" name="expectedDate" data-today data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" required /></label>
            <label>Tipo de registro<select name="recordType"><option value="Individual">Individual</option><option value="Consolidated">Consolidado do dia</option></select></label>
        </div>
        <details class="advanced-fields">
            <summary>Adicionar custo, receita ou taxa efetiva</summary>
            <div class="grid">
                <label>Custo direto da venda<input type="text" inputmode="decimal" class="decimal-input" name="cost" placeholder="Ex.: 12,50" /><span class="hint">Em branco significa custo desconhecido.</span></label>
                <label>Receita de referência<select name="recipeId" id="sale-recipe"><option value="">Sem receita</option></select></label>
                <label>Unidades da receita<input type="number" step="0.001" min="0.001" value="1" name="recipeQuantity" /></label>
                <label>Taxas efetivas da venda<input type="text" inputmode="decimal" class="decimal-input" name="fee" placeholder="Ex.: 2,50" /><span class="hint">Em branco usa as taxas configuradas.</span></label>
                <label class="wide">Descrição<input name="description" maxlength="300" /></label>
            </div>
            <p class="hint">Ao informar uma receita, deixe o custo direto vazio. No consolidado do dia, não inclua vendas já registradas individualmente.</p>
        </details>
        <div class="actions"><button type="submit">Registrar venda pendente</button></div>
    </form>
</section>
<div class="split">
<section id="expense-section" class="entry-section entry-expense">
    <h2>Registrar uma despesa</h2>
    <form id="expense-form">
        <div class="grid">
            <label>Data da despesa<input type="text" name="date" data-today data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" required /></label>
            <label>Vencimento<input type="text" name="dueDate" data-today data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" required /></label>
            <label>Valor da despesa<input type="text" inputmode="decimal" class="decimal-input" name="amount" placeholder="Ex.: 45,90" required /></label>
            <label>Categoria<select name="categoryId" data-catalog="categories" required></select></label>
            <label class="wide">Descrição<input name="description" maxlength="300" required /></label>
        </div>
        <p class="hint">Use “Compra de insumos” para ingredientes e embalagens. Gastos já incluídos no custo das receitas não são descontados novamente do resultado.</p>
        <div class="actions"><button type="submit">Registrar despesa pendente</button></div>
    </form>
</section>
<section id="owner-section" class="entry-section entry-owner">
    <h2>Aporte ou retirada</h2>
    <form id="owner-form">
        <div class="grid">
            <label>Data da movimentação<input type="text" name="date" data-today data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" required /></label>
            <label>Tipo<select name="kind"><option value="Contribution">Aporte</option><option value="Withdrawal">Retirada pessoal</option></select></label>
            <label>Valor da movimentação<input type="text" inputmode="decimal" class="decimal-input" name="amount" placeholder="Ex.: 100,00" required /></label>
            <label>Descrição<input name="description" maxlength="300" required /></label>
        </div>
        <p class="hint">Aporte não é faturamento. Retirada pessoal reduz o caixa sem ser custo do produto.</p>
        <div class="actions"><button type="submit">Registrar movimentação</button></div>
    </form>
</section>
</div>
<section id="movement-history" class="movement-history">
    <h2>Histórico de lançamentos</h2>
    <form id="movement-filter"><div class="grid filters">
        <label>De<input type="text" name="from" data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" /></label><label>Até<input type="text" name="to" data-date-br inputmode="numeric" placeholder="dd/mm/aaaa" pattern="[0-3][0-9]/[01][0-9]/[0-9]{4}" /></label>
        <label>Canal<select name="channelId" data-catalog="channels"><option value="">Todos</option></select></label>
        <label>Meio de pagamento<select name="paymentMethodId" data-catalog="paymentMethods"><option value="">Todos</option></select></label>
        <label>Categoria<select name="categoryId" data-catalog="categories"><option value="">Todas</option></select></label>
        <label>Situação<select name="status"><option value="">Todas</option><option value="Pending">Pendente</option><option value="Received">Venda recebida</option><option value="Paid">Despesa paga</option><option value="Cancelled">Cancelado</option></select></label>
    </div><div class="actions"><button type="submit" class="secondary">Consultar</button></div></form>
    <h3>Vendas</h3><div class="table-wrap"><table><thead><tr><th>Data</th><th>Descrição e canal</th><th class="money">Bruto</th><th class="money">Taxas</th><th class="money">Líquido</th><th>Situação</th><th>Ações</th></tr></thead><tbody id="sale-rows"></tbody></table></div>
    <h3>Despesas</h3><div class="table-wrap"><table><thead><tr><th>Competência</th><th>Descrição</th><th>Vencimento</th><th class="money">Valor</th><th>Situação</th><th>Ações</th></tr></thead><tbody id="expense-rows"></tbody></table></div>
    <h3>Aportes e retiradas</h3><div class="table-wrap"><table><thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th class="money">Valor</th><th>Situação</th><th>Ações</th></tr></thead><tbody id="owner-rows"></tbody></table></div>
    <div class="actions"><button type="button" id="previous-page" class="secondary">Página anterior</button><span id="page-info"></span><button type="button" id="next-page" class="secondary">Próxima página</button></div>
</section>
@section Scripts { <script src="~/js/movements.js" asp-append-version="true"></script> }
